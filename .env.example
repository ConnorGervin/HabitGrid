# ---- Browser (Vite) – public values, baked into the build ----
# Public half of your VAPID key pair (npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# ---- Server only – set these in Vercel → Project → Settings → Environment Variables ----
# Long random string. Paste the same value into Settings → Sync token on each device.
SYNC_TOKEN=
# Fine-grained GitHub token: "Contents: Read and write" on the private data repo only
GITHUB_TOKEN=
# Private repo that holds habits.json and push.json, e.g. your-name/habitgrid-data
GITHUB_DATA_REPO=
# VAPID key pair (same public key as VITE_VAPID_PUBLIC_KEY above)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Secret used by the free external scheduler that calls /api/cron/remind every 15 minutes
CRON_SECRET=
